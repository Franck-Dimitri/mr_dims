[Unit]
Description=Watchdog Alertes Temps Réel Telegram pour VPS
After=network.target

[Service]
Type=simple
User=mrdims
Group=mrdims
WorkingDirectory=/var/www/mrdims-portfolio/telegram-bot
ExecStart=/var/www/mrdims-portfolio/venv/bin/python watchdog.py
Restart=always
RestartSec=10
EnvironmentFile=/var/www/mrdims-portfolio/telegram-bot/.env

[Install]
WantedBy=multi-user.target
