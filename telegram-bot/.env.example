# =========================================================
# CONFIGURATION DU BOT TELEGRAM SUPERVISEUR VPS
# =========================================================

# 1. Identifiants Telegram (requis)
# Obtenez votre token auprès de @BotFather
TELEGRAM_BOT_TOKEN=VOTRE_TOKEN_TELEGRAM_BOT_ICI
# Obtenez votre Chat ID personnel auprès de @userinfobot ou @raw_data_bot
TELEGRAM_CHAT_ID=VOTRE_CHAT_ID_NUMERIQUE_ICI

# 2. Configuration Projet & Serveur
PROJECT_NAME="VPS Supervisor"
PROJECT_PATH=/var/www/mrdims-portfolio
PROJECT_URL=http://localhost

# 3. Base de données (sqlite ou mysql)
DB_ENGINE=sqlite
SQLITE_PATH=/var/www/mrdims-portfolio/database/database.sqlite

# (Optionnel si DB_ENGINE=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio_db
DB_USER=portfolio_user
DB_PASSWORD=secret

# 4. Dossier de destination des sauvegardes
BACKUP_DIR=/var/www/mrdims-portfolio/backups
RETENTION_DAYS=14

# 5. Seuils d'alerte proactive (%)
CPU_THRESHOLD=85.0
RAM_THRESHOLD=90.0
DISK_THRESHOLD=85.0

# 6. Contrôle à distance du serveur
ENABLE_ARBITRARY_SHELL=true
SHELL_TIMEOUT=45

# 7. Services critiques à surveiller (séparés par virgules)
CRITICAL_SERVICES=nginx,mysql,php8.2-fpm,php8.3-fpm,docker
